# Copiá este archivo como .env (el instalador lo crea solo).
PF_DB_PATH=/opt/portafolios/data/portafolios.db
# Código que les pasás a tus amigos para crear su cuenta. Vacío = registro cerrado.
PF_INVITE_CODE=cambiame
# 1 cuando la app se sirve por HTTPS (con Caddy). Para probar en tu compu sin HTTPS, poné 0.
PF_SECURE_COOKIES=1
# Cada cuántos segundos se actualizan los precios
PF_FAST_INTERVAL=20
PF_SLOW_INTERVAL=60
